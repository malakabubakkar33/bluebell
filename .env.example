# ========================================================
# Blue Bells Mobile Shop - Environment Configuration Template
# ========================================================
# Copy this file to .env.local for local development.
# On deployment platforms (e.g. Vercel, Hostinger, Netlify), configure these in Environment Variables settings.

# Supabase Public Configuration (Required for storefront, authentication & client/server queries)
NEXT_PUBLIC_SUPABASE_URL=https://duujhipnbythezqtmdbk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_eyt1FI5cXiT0oF-DKPQ_Qw_-DbWkiif
SUPABASE_URL=https://duujhipnbythezqtmdbk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_eyt1FI5cXiT0oF-DKPQ_Qw_-DbWkiif

# Supabase Privileged Service Key (Server-side only - NEVER expose to browser)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Secret / Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# PostgreSQL Direct Connection String (Optional / Server-side)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Store Contact Information
NEXT_PUBLIC_STORE_PHONE=+92 300 1234567
NEXT_PUBLIC_STORE_EMAIL=support@bluebell.pk

